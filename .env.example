# ── Ollama ─────────────────────────────────────────────────────────────
# Base URL for the Ollama API (default: http://localhost:11434/api)
# OLLAMA_URL=http://localhost:11434/api
#
# In a Lima VM / dev-container setup where Ollama runs on the HOST rather
# than inside the container, "localhost" refers to the container itself,
# not the host — the host is reached at http://host.lima.internal:11434/api
# instead. This does not change the code default (localhost is still
# correct for a normal, non-containerized install); set OLLAMA_URL
# explicitly in this kind of environment instead.
# OLLAMA_URL=http://host.lima.internal:11434/api

# ── MiniMax (OpenAI-compatible) ───────────────────────────────────────
# Set your MiniMax API key to enable MiniMax models.
# Available models are fetched automatically from the MiniMax API.
# MINIMAX_API_KEY=your-minimax-api-key-here
# MINIMAX_BASE_URL=https://api.minimaxi.chat/v1

# ── Brave Search ─────────────────────────────────────────────────────
# Set your Brave Search API key to enable the web_search tool.
# Get a free key at https://brave.com/search/api/
# BRAVE_API_KEY=your-brave-api-key-here

# ── Server ────────────────────────────────────────────────────────────
# Port for the server (default: 3000). Serves both the frontend and
# WebSocket/API backend on a single port in production.
# PORT=3000

# ── Frontend (dev override) ───────────────────────────────────────────
# Override the WebSocket URL when running frontend and backend on separate
# ports (e.g. in dev mode). In production, the frontend auto-detects from
# the page URL.
# NEXT_PUBLIC_WS_URL=ws://localhost:3001

# ── MCP ───────────────────────────────────────────────────────────────
# Path to MCP server configuration (default: ./server/mcp-config.json)
# MCP_CONFIG=./server/mcp-config.json
