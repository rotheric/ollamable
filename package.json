{
  "name": "ollamable",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/run-dev.mjs",
    "dev:server": "tsx watch server/index.ts",
    "dev:auto": "node scripts/run-dev.mjs",
    "dev:full": "node scripts/run-dev.mjs",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "lint": "next lint",
    "test": "node scripts/run-checks.mjs",
    "test:unit": "vitest run",
    "test:integration": "vitest run -c vitest.server.config.ts",
    "test:e2e": "node scripts/run-playwright.mjs",
    "test:mutation:server": "stryker run stryker.server.conf.json",
    "test:mutation:client": "stryker run stryker.client.conf.json",
    "test:mutation": "npm run test:mutation:server && npm run test:mutation:client",
    "typecheck": "tsc --noEmit --incremental false && tsc -p tsconfig.server.json --noEmit --incremental false",
    "dev:frontend": "next dev",
    "check": "node scripts/run-checks.mjs",
    "check:records": "node scripts/check-project-records.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@modelcontextprotocol/sdk": "^1.28.0",
    "@mui/icons-material": "^7.0.2",
    "@mui/material": "^7.0.2",
    "next": "^15.2.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-joyride": "^3.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@modyfi/vite-plugin-yaml": "^1.1.1",
    "@playwright/test": "^1.54.2",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.13.14",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.2",
    "fast-check": "^4.10.2",
    "jsdom": "^26.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.7",
    "yaml-loader": "^0.9.0"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "js-yaml": "^4.3.2",
    "next": {
      "postcss": "^8.5.28"
    },
    "typed-rest-client": {
      "qs": "^6.16.0"
    }
  }
}
