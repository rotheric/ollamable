{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.ts"
  },
  "reporters": [
    "json",
    "clear-text",
    "progress"
  ],
  "jsonReporter": {
    "fileName": "reports/mutation/client/mutation.json"
  },
  "mutate": [
    "src/lib/token-view.ts",
    "src/components/request-preview-extras.tsx",
    "src/components/token-view-step-content.tsx",
    "src/lib/backend-client.ts",
    "src/lib/chat.ts",
    "src/lib/use-websocket.ts"
  ],
  "ignorePatterns": [
    ".next",
    "out",
    "test-results",
    "reports",
    "playwright-report"
  ],
  "coverageAnalysis": "perTest",
  "timeoutMS": 30000,
  "disableTypeChecks": true
}
